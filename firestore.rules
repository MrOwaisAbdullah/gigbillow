/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for a time-tracking and invoicing application.
 *
 * Data Structure:
 * All application data (clients, projects, time entries, invoices) is nested under the /users/{userId} collection.
 * Token data is stored in a top-level /user_tokens/{userId} collection.
 *
 * Key Security Decisions:
 * - Users can only access data that belongs to them.
 * - No user listing is allowed.
 * - The rules explicitly deny any operation that is not explicitly allowed.
 * - Data required for authorization is denormalized onto the secured documents to avoid extra reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing document.
     */
    function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && resource.data != null;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their profile with matching ID.
     * @deny (create) - User with UID 'user123' cannot create a profile with ID 'otherUser'.
     * @principle Enforces user-ownership for profile creation.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for clients belonging to a user.
     * @path /users/{userId}/clients/{clientId}
     * @allow (create) - User with UID 'user123' can create a client under their user ID.
     * @deny (update) - User with UID 'user123' cannot update a client under another user ID.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/clients/{clientId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for projects belonging to a user.
     * @path /users/{userId}/projects/{projectId}
     * @allow (create) - User with UID 'user123' can create a project under their user ID.
     * @deny (update) - User with UID 'user123' cannot update a project under another user ID.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/projects/{projectId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for time entries belonging to a user.
     * @path /users/{userId}/timeEntries/{timeEntryId}
     * @allow (create) - User with UID 'user123' can create a time entry under their user ID.
     * @deny (update) - User with UID 'user123' cannot update a time entry under another user ID.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/timeEntries/{timeEntryId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for invoices belonging to a user.
     * @path /users/{userId}/invoices/{invoiceId}
     * @allow (create) - User with UID 'user123' can create an invoice under their user ID.
     * @deny (update) - User with UID 'user123' cannot update an invoice under another user ID.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/invoices/{invoiceId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

     /**
      * @description Rules for user tokens.
      * @path /user_tokens/{userId}
      * @allow (create) - User with UID 'user123' can create their tokens with matching ID.
      * @deny (create) - User with UID 'user123' cannot create tokens with ID 'otherUser'.
      * @principle Enforces user-ownership for token.
      */
    match /user_tokens/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}