/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model.  Users can only
 * access their own data, with the exception of publicly readable collections
 * (none currently defined). This provides a secure foundation while allowing
 * flexibility in data shapes during the prototyping phase. Schema validation
 * is minimal and focused on maintaining relational integrity and preventing
 * unauthorized data access.
 *
 * Data Structure:
 * Data is primarily nested under `/users/{userId}`, creating a private
 * data tree for each user.  The `/user_tokens/{userId}` collection is also secured
 * on a per-user basis.
 *
 * Key Security Decisions:
 * - User listing is disabled to prevent enumeration attacks.
 * - All write operations are protected by authorization checks based on the
 *   authenticated user's UID.
 *
 * Denormalization for Authorization:
 *  No denormalization is needed at this time; user ownership is verified directly
 *  via path matching.  If more complex authorization schemes are needed (e.g.,
 *  shared projects), consider adding fields like `ownerId` or `memberIds` to
 *  documents to avoid costly `get()` calls in rules.
 *
 * Structural Segregation:
 * There are no collections that require a public/private separation in this data model.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Basic check for authentication.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces user ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing document.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Combines ownership and existence checks for safer destructive operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }


    /**
     * @description Manages access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile document at /users/user123.
     * @allow (get) User with UID 'user123' can read their profile document at /users/user123.
     * @allow (update) User with UID 'user123' can update their profile document at /users/user123.
     * @allow (delete) User with UID 'user123' can delete their profile document at /users/user123.
     * @deny (create) User with UID 'user456' cannot create a profile document at /users/user123.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to client documents for a specific user.
     * @path /users/{userId}/clients/{clientId}
     * @allow (create) User with UID 'user123' can create a client document at /users/user123/clients/client456.
     * @allow (get) User with UID 'user123' can read a client document at /users/user123/clients/client456.
     * @allow (update) User with UID 'user123' can update a client document at /users/user123/clients/client456.
     * @allow (delete) User with UID 'user123' can delete a client document at /users/user123/clients/client456.
     * @deny (create) User with UID 'user456' cannot create a client document at /users/user123/clients/client456.
     * @principle Enforces document ownership for all operations within the user's client subcollection.
     */
    match /users/{userId}/clients/{clientId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to project documents for a specific user.
     * @path /users/{userId}/projects/{projectId}
     * @allow (create) User with UID 'user123' can create a project document at /users/user123/projects/project456.
     * @allow (get) User with UID 'user123' can read a project document at /users/user123/projects/project456.
     * @allow (update) User with UID 'user123' can update a project document at /users/user123/projects/project456.
     * @allow (delete) User with UID 'user123' can delete a project document at /users/user123/projects/project456.
     * @deny (create) User with UID 'user456' cannot create a project document at /users/user123/projects/project456.
     * @principle Enforces document ownership for all operations within the user's project subcollection.
     */
    match /users/{userId}/projects/{projectId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to time entry documents for a specific user.
     * @path /users/{userId}/timeEntries/{timeEntryId}
     * @allow (create) User with UID 'user123' can create a time entry document at /users/user123/timeEntries/timeEntry456.
     * @allow (get) User with UID 'user123' can read a time entry document at /users/user123/timeEntries/timeEntry456.
     * @allow (update) User with UID 'user123' can update a time entry document at /users/user123/timeEntries/timeEntry456.
     * @allow (delete) User with UID 'user123' can delete a time entry document at /users/user123/timeEntries/timeEntry456.
     * @deny (create) User with UID 'user456' cannot create a time entry document at /users/user123/timeEntries/timeEntry456.
     * @principle Enforces document ownership for all operations within the user's time entry subcollection.
     */
    match /users/{userId}/timeEntries/{timeEntryId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to invoice documents for a specific user.
     * @path /users/{userId}/invoices/{invoiceId}
     * @allow (create) User with UID 'user123' can create an invoice document at /users/user123/invoices/invoice456.
     * @allow (get) User with UID 'user123' can read an invoice document at /users/user123/invoices/invoice456.
     * @allow (update) User with UID 'user123' can update an invoice document at /users/user123/invoices/invoice456.
     * @allow (delete) User with UID 'user123' can delete an invoice document at /users/user123/invoices/invoice456.
     * @deny (create) User with UID 'user456' cannot create an invoice document at /users/user123/invoices/invoice456.
     * @principle Enforces document ownership for all operations within the user's invoice subcollection.
     */
    match /users/{userId}/invoices/{invoiceId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to expense documents for a specific user.
     * @path /users/{userId}/expenses/{expenseId}
     * @allow (create) User with UID 'user123' can create an expense document at /users/user123/expenses/expense456.
     * @allow (get) User with UID 'user123' can read an expense document at /users/user123/expenses/expense456.
     * @allow (update) User with UID 'user123' can update an expense document at /users/user123/expenses/expense456.
     * @allow (delete) User with UID 'user123' can delete an expense document at /users/user123/expenses/expense456.
     * @deny (create) User with UID 'user456' cannot create an expense document at /users/user123/expenses/expense456.
     * @principle Enforces document ownership for all operations within the user's expense subcollection.
     */
    match /users/{userId}/expenses/{expenseId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to referral documents for a specific user.
     * @path /users/{userId}/referrals/{referralId}
     * @allow (create) User with UID 'user123' can create a referral document at /users/user123/referrals/referral456.
     * @allow (get) User with UID 'user123' can read a referral document at /users/user123/referrals/referral456.
     * @allow (update) User with UID 'user123' can update a referral document at /users/user123/referrals/referral456.
     * @allow (delete) User with UID 'user123' can delete a referral document at /users/user123/referrals/referral456.
     * @deny (create) User with UID 'user456' cannot create a referral document at /users/user123/referrals/referral456.
     * @principle Enforces document ownership for all operations within the user's referral subcollection.
     */
    match /users/{userId}/referrals/{referralId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to user token documents.
     * @path /user_tokens/{userId}
     * @allow (create) User with UID 'user123' can create their token document at /user_tokens/user123.
     * @allow (get) User with UID 'user123' can read their token document at /user_tokens/user123.
     * @allow (update) User with UID 'user123' can update their token document at /user_tokens/user123.
     * @allow (delete) User with UID 'user123' can delete their token document at /user_tokens/user123.
     * @deny (create) User with UID 'user456' cannot create a token document at /user_tokens/user123.
     * @principle Enforces document ownership for all operations.
     */
    match /user_tokens/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}