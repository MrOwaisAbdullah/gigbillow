/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for most data,
 *              allowing users to only access and modify their own resources.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only by the user themselves.
 * - /users/{userId}/clients/{clientId}: Clients owned by a specific user.
 * - /users/{userId}/projects/{projectId}: Projects owned by a specific user.
 * - /users/{userId}/timeEntries/{timeEntryId}: Time entries owned by a specific user.
 * - /users/{userId}/invoices/{invoiceId}: Invoices owned by a specific user.
 * - /user_tokens/{userId}: User token balance, accessible only by the user themselves.
 * - /referrals/{referralId}: Referral records.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profiles.
 * - Clients, projects, time entries, and invoices are all strictly user-owned.
 * - User tokens are only accessible by the user themselves.
 * - Listing of user subcollections is allowed only for the owner.
 * - Referral records can be created by any authenticated user, but only the record itself can be read or updated.
 *
 * Denormalization for Authorization:
 *  - User ownership is enforced by matching the {userId} path segment with the
 *    requesting user's authentication UID.  No additional data denormalization
 *    is required, as the path itself serves as the source of truth.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (get, update, delete) User with ID 'user123' can access their own profile.
     * @allow (create) User with ID 'user123' can create their own profile if it doesn't exist.
     * @deny (get, update, delete) User with ID 'user456' cannot access 'user123' profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to client documents under a user.
     * @path /users/{userId}/clients/{clientId}
     * @allow (get, list, create, update, delete) User with ID 'user123' can manage their clients.
     * @deny (get, list, create, update, delete) User with ID 'user456' cannot manage 'user123' clients.
     * @principle Enforces user-ownership for clients.
     */
    match /users/{userId}/clients/{clientId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to project documents under a user.
     * @path /users/{userId}/projects/{projectId}
     * @allow (get, list, create, update, delete) User with ID 'user123' can manage their projects.
     * @deny (get, list, create, update, delete) User with ID 'user456' cannot manage 'user123' projects.
     * @principle Enforces user-ownership for projects.
     */
    match /users/{userId}/projects/{projectId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to time entry documents under a user.
     * @path /users/{userId}/timeEntries/{timeEntryId}
     * @allow (get, list, create, update, delete) User with ID 'user123' can manage their time entries.
     * @deny (get, list, create, update, delete) User with ID 'user456' cannot manage 'user123' time entries.
     * @principle Enforces user-ownership for time entries.
     */
    match /users/{userId}/timeEntries/{timeEntryId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to invoice documents under a user.
     * @path /users/{userId}/invoices/{invoiceId}
     * @allow (get, list, create, update, delete) User with ID 'user123' can manage their invoices.
     * @deny (get, list, create, update, delete) User with ID 'user456' cannot manage 'user123' invoices.
     * @principle Enforces user-ownership for invoices.
     */
    match /users/{userId}/invoices/{invoiceId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to user token documents.
     * @path /user_tokens/{userId}
     * @allow (get, update, delete) User with ID 'user123' can access their own token balance.
     * @deny (get, update, delete) User with ID 'user456' cannot access 'user123' token balance.
     * @principle Enforces document ownership for user tokens.
     */
    match /user_tokens/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

      /**
       * @description Controls access to referral documents.
       * @path /referrals/{referralId}
       * @allow (create) Any authenticated user can create a referral record.
       * @allow (get, update, delete) Only the referrer user can get, update, or delete the referral record.
       * @deny (get, update, delete) Another user cannot access or modify the referral record.
       * @principle Allows authenticated users to create referral records, but restricts access to only the referrer.
       */
      match /referrals/{referralId} {
          function isSignedIn() {
              return request.auth != null;
          }

          // Allow any signed-in user to create a referral record.
          allow create: if isSignedIn();

          // Only the user who created the referral record can access it.
          allow get: if request.auth != null && request.auth.uid == resource.data.referrer_user_id;
          allow list: if false;
          allow update: if request.auth != null && request.auth.uid == resource.data.referrer_user_id && resource != null;
          allow delete: if request.auth != null && request.auth.uid == resource.data.referrer_user_id && resource != null;
      }
  }
}