/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for all data. Each user can only access their own data.
 *
 * Data Structure:
 * - All data is nested under /users/{userId}, /user_tokens/{userId} collections, ensuring data isolation between users.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Listing of users is disallowed.
 * - Users can only manage their own clients, projects, time entries and invoices.
 * - Read and write access to /user_tokens/{userId} is restricted to the owner.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Secure user profiles. Users can only read and write their own profile.
     * @path /users/{userId}
     * @allow (get) User with ID 'user123' can read their own profile.
     * @allow (create) User with ID 'user123' can create their own profile.
     * @allow (update) User with ID 'user123' can update their own profile.
     * @allow (delete) User with ID 'user123' can delete their own profile.
     * @deny (get) User with ID 'user456' cannot read user 'user123' profile.
     * @deny (create) User with ID 'user456' cannot create user 'user123' profile.
     * @deny (update) User with ID 'user456' cannot update user 'user123' profile.
     * @deny (delete) User with ID 'user456' cannot delete user 'user123' profile.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure client data. Users can only manage their own clients.
     * @path /users/{userId}/clients/{clientId}
     * @allow (create) User with ID 'user123' can create a client under their user ID.
     * @allow (get) User with ID 'user123' can read a client under their user ID.
     * @allow (update) User with ID 'user123' can update a client under their user ID.
     * @allow (delete) User with ID 'user123' can delete a client under their user ID.
     * @deny (create) User with ID 'user456' cannot create a client under user 'user123'.
     * @deny (get) User with ID 'user456' cannot read a client under user 'user123'.
     * @deny (update) User with ID 'user456' cannot update a client under user 'user123'.
     * @deny (delete) User with ID 'user456' cannot delete a client under user 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/clients/{clientId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure project data. Users can only manage their own projects.
     * @path /users/{userId}/projects/{projectId}
     * @allow (create) User with ID 'user123' can create a project under their user ID.
     * @allow (get) User with ID 'user123' can read a project under their user ID.
     * @allow (update) User with ID 'user123' can update a project under their user ID.
     * @allow (delete) User with ID 'user123' can delete a project under their user ID.
     * @deny (create) User with ID 'user456' cannot create a project under user 'user123'.
     * @deny (get) User with ID 'user456' cannot read a project under user 'user123'.
     * @deny (update) User with ID 'user456' cannot update a project under user 'user123'.
     * @deny (delete) User with ID 'user456' cannot delete a project under user 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/projects/{projectId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure time entry data. Users can only manage their own time entries.
     * @path /users/{userId}/timeEntries/{timeEntryId}
     * @allow (create) User with ID 'user123' can create a time entry under their user ID.
     * @allow (get) User with ID 'user123' can read a time entry under their user ID.
     * @allow (update) User with ID 'user123' can update a time entry under their user ID.
     * @allow (delete) User with ID 'user123' can delete a time entry under their user ID.
     * @deny (create) User with ID 'user456' cannot create a time entry under user 'user123'.
     * @deny (get) User with ID 'user456' cannot read a time entry under user 'user123'.
     * @deny (update) User with ID 'user456' cannot update a time entry under user 'user123'.
     * @deny (delete) User with ID 'user456' cannot delete a time entry under user 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/timeEntries/{timeEntryId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure invoice data. Users can only manage their own invoices.
     * @path /users/{userId}/invoices/{invoiceId}
     * @allow (create) User with ID 'user123' can create an invoice under their user ID.
     * @allow (get) User with ID 'user123' can read an invoice under their user ID.
     * @allow (update) User with ID 'user123' can update an invoice under their user ID.
     * @allow (delete) User with ID 'user123' can delete an invoice under their user ID.
     * @deny (create) User with ID 'user456' cannot create an invoice under user 'user123'.
     * @deny (get) User with ID 'user456' cannot read an invoice under user 'user123'.
     * @deny (update) User with ID 'user456' cannot update an invoice under user 'user123'.
     * @deny (delete) User with ID 'user456' cannot delete an invoice under user 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/invoices/{invoiceId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

   /**
    * @description Secure user token data. Users can only manage their own token balance.
    * @path /user_tokens/{userId}
    * @allow (create) User with ID 'user123' can create a token record under their user ID.
    * @allow (get) User with ID 'user123' can read a token record under their user ID.
    * @allow (update) User with ID 'user123' can update a token record under their user ID.
    * @allow (delete) User with ID 'user123' can delete a token record under their user ID.
    * @deny (create) User with ID 'user456' cannot create a token record under user 'user123'.
    * @deny (get) User with ID 'user456' cannot read a token record under user 'user123'.
    * @deny (update) User with ID 'user456' cannot update a token record under user 'user123'.
    * @deny (delete) User with ID 'user456' cannot delete a token record under user 'user123'.
    * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
    */
    match /user_tokens/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

   /**
    * @description Secure referral data. Users can only manage their own referral records.
    * @path /users/{userId}/referrals/{referralId}
    * @allow (create) User with ID 'user123' can create a referral record under their user ID.
    * @allow (get) User with ID 'user123' can read a referral record under their user ID.
    * @allow (update) User with ID 'user123' can update a referral record under their user ID.
    * @allow (delete) User with ID 'user123' can delete a referral record under their user ID.
    * @deny (create) User with ID 'user456' cannot create a referral record under user 'user123'.
    * @deny (get) User with ID 'user456' cannot read a referral record under user 'user123'.
    * @deny (update) User with ID 'user456' cannot update a referral record under user 'user123'.
    * @deny (delete) User with ID 'user456' cannot delete a referral record under user 'user123'.
    * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
    */
    match /users/{userId}/referrals/{referralId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}