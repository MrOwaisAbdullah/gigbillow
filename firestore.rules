/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for most data, with public read access to the user profiles collection.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, readable by everyone but writable only by the owning user.
 * - /users/{userId}/clients/{clientId}: Clients belonging to a specific user, accessible only by that user.
 * - /users/{userId}/projects/{projectId}: Projects belonging to a specific user, accessible only by that user.
 * - /users/{userId}/timeEntries/{timeEntryId}: Time entries belonging to a specific user, accessible only by that user.
 * - /users/{userId}/invoices/{invoiceId}: Invoices belonging to a specific user, accessible only by that user.
 * - /user_tokens/{userId}: Token balances for each user, accessible only by that user.
 * - /referrals/{referralId}: Referral records, accessible only by the creating user (referrer_user_id).
 *
 * Key Security Decisions:
 * - User profiles are publicly readable.
 * - User listing is disallowed.
 * - Write operations on all user-owned data are restricted to the owner.
 *
 * Denormalization for Authorization:
 *  - The rules depend on the path to determine the user ID, and thus the owner.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read-only access to user profiles, with owner-only writes.
     * @path /users/{userId}
     * @allow (get, list): if true
     * @allow (create): if request.auth.uid == userId
     * @allow (update, delete): if request.auth.uid == userId && resource != null
     * @deny (create): if request.auth == null
     * @deny (update): if request.auth == null
     * @deny (delete): if request.auth == null
     * @principle Public read access, owner-only writes.
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Enforces owner-only access to clients.
     * @path /users/{userId}/clients/{clientId}
     * @allow (create): if request.auth.uid == userId
     * @allow (get, list, update, delete): if request.auth.uid == userId
     * @deny (create, update, delete): if request.auth == null
     * @deny (list): if request.auth == null
     * @principle Owner-only access to clients.
     */
    match /users/{userId}/clients/{clientId} {
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Enforces owner-only access to projects.
     * @path /users/{userId}/projects/{projectId}
     * @allow (create): if request.auth.uid == userId
     * @allow (get, list, update, delete): if request.auth.uid == userId
     * @deny (create, update, delete): if request.auth == null
     * @deny (list): if request.auth == null
     * @principle Owner-only access to projects.
     */
    match /users/{userId}/projects/{projectId} {
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Enforces owner-only access to time entries.
     * @path /users/{userId}/timeEntries/{timeEntryId}
     * @allow (create): if request.auth.uid == userId
     * @allow (get, list, update, delete): if request.auth.uid == userId
     * @deny (create, update, delete): if request.auth == null
     * @deny (list): if request.auth == null
     * @principle Owner-only access to time entries.
     */
    match /users/{userId}/timeEntries/{timeEntryId} {
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Enforces owner-only access to invoices.
     * @path /users/{userId}/invoices/{invoiceId}
     * @allow (create): if request.auth.uid == userId
     * @allow (get, list, update, delete): if request.auth.uid == userId
     * @deny (create, update, delete): if request.auth == null
     * @deny (list): if request.auth == null
     * @principle Owner-only access to invoices.
     */
    match /users/{userId}/invoices/{invoiceId} {
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Enforces owner-only access to user tokens.
     * @path /user_tokens/{userId}
     * @allow (create): if request.auth.uid == userId
     * @allow (get, list, update, delete): if request.auth.uid == userId
     * @deny (create, update, delete): if request.auth == null
     * @deny (list): if request.auth == null
     * @principle Owner-only access to user tokens.
     */
    match /user_tokens/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

       /**
        * @description Enforces owner-only access to referrals.
        * @path /referrals/{referralId}
        * @allow (create): if request.auth.uid == request.resource.data.referrer_user_id
        * @allow (get, list, update, delete): if request.auth.uid == resource.data.referrer_user_id && resource != null;
        * @deny (create, update, delete): if request.auth == null
        * @deny (list): if request.auth == null
        * @principle Owner-only access to referrals based on referrer_user_id.
        */
    match /referrals/{referralId} {
        allow get: if isSignedIn() && isReferrer(resource.data.referrer_user_id);
        allow list: if false;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.referrer_user_id;
        allow update: if isSignedIn() && isExistingReferrer(resource.data.referrer_user_id);
        allow delete: if isSignedIn() && isExistingReferrer(resource.data.referrer_user_id);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isReferrer(referrerUserId) {
        return request.auth.uid == referrerUserId;
    }

    function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
    }

    function isExistingReferrer(referrerUserId) {
        return isSignedIn() && isReferrer(referrerUserId) && resource != null;
    }
  }
}