/**
 * @file Firestore Security Rules
 * @core-philosophy This ruleset enforces a strict user-ownership model. Users can only
 *  access data that belongs to them. All write operations require a valid,
 *  authenticated user.
 * @data-structure Data is organized under user-specific subcollections
 *  (e.g., /users/{userId}/clients/{clientId}).
 * @key-security-decisions User listing is disallowed. Referential integrity is enforced
 *  on create operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user ID matches the requested user ID.
     * @param {string} userId The user ID to check against.
     * @return {bool} True if the user ID matches, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of an existing document.
     * @param {string} userId The user ID to check against.
     * @return {bool} True if the user is the owner and the document exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource.data != null;
    }

    /**
     * @description Root-level read rules to prevent accidental open access.
     */
    match /{path=**} {
      allow get: if false;
      allow list: if false;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     * @deny (create) User with ID 'user123' cannot create a profile for 'user456'.
     * @principle Enforces document ownership for writes, validates relational integrity on create.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Rules for clients subcollection.
     * @path /users/{userId}/clients/{clientId}
     * @allow (create) User with ID 'user123' can create a client under their profile.
     * @deny (create) User with ID 'user123' cannot create a client under 'user456' profile.
     * @principle Enforces document ownership for writes, restricts access to user's own data tree.
     */
    match /users/{userId}/clients/{clientId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Rules for projects subcollection.
     * @path /users/{userId}/projects/{projectId}
     * @allow (create) User with ID 'user123' can create a project under their profile.
     * @deny (create) User with ID 'user123' cannot create a project under 'user456' profile.
     * @principle Enforces document ownership for writes, restricts access to user's own data tree.
     */
    match /users/{userId}/projects/{projectId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Rules for time entries subcollection.
     * @path /users/{userId}/timeEntries/{timeEntryId}
     * @allow (create) User with ID 'user123' can create a time entry under their profile.
     * @deny (create) User with ID 'user123' cannot create a time entry under 'user456' profile.
     * @principle Enforces document ownership for writes, restricts access to user's own data tree.
     */
    match /users/{userId}/timeEntries/{timeEntryId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Rules for invoices subcollection.
     * @path /users/{userId}/invoices/{invoiceId}
     * @allow (create) User with ID 'user123' can create an invoice under their profile.
     * @deny (create) User with ID 'user123' cannot create an invoice under 'user456' profile.
     * @principle Enforces document ownership for writes, restricts access to user's own data tree.
     */
    match /users/{userId}/invoices/{invoiceId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Rules for user tokens collection.
     * @path /user_tokens/{userId}
     * @allow (create) User with ID 'user123' can create their own token document.
     * @deny (create) User with ID 'user123' cannot create a token document for 'user456'.
     * @principle Enforces document ownership for writes, restricts access to user's own data.
     */
    match /user_tokens/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
      /**
       * @description Rules for referrals subcollection.
       * @path /users/{userId}/referrals/{referralId}
       * @allow (list) User with ID 'user123' can list referrals under their profile.
       * @allow (create) User with ID 'user123' can create a referral under their profile.
       * @deny (create) User with ID 'user123' cannot create a referral under 'user456' profile.
       * @principle Enforces document ownership for writes, restricts access to user's own data tree.
       */
      match /users/{userId}/referrals/{referralId} {
        allow get: if isOwner(userId);
        allow list: if false;

        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isSignedIn() && isOwner(userId);
        allow delete: if isSignedIn() && isOwner(userId);
      }
    /**
     * @description Rules for referrals collection.
     * @path /referrals/{referralId}
     * @allow (list) User with ID 'user123' can list referrals.
     * @principle Enforces document ownership for writes, restricts access to user's own data tree.
     */
      match /referrals/{referralId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();

        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
      }
  }
}