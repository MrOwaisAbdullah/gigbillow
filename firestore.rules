/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for most data, ensuring that users can only access their own resources.
 *
 * Data Structure:
 * All personal data is nested under /users/{userId}. User tokens and referrals are stored in top-level collections, secured by user ID.
 *
 * Key Security Decisions:
 * - Users can only list expenses that they own.
 * - Users can only create their own user document.
 *
 * Denormalization for Authorization:
 *  - No denormalization is needed, as the rules use the path to enforce ownership.
 *
 * Structural Segregation:
 *  - Private user data is stored under the `/users/{userId}` collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to a user's profile if the requesting user is the profile owner.
     * @path /users/{userId}
     * @allow (create) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can create document with id "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @deny (create) User with uid "OTHER_USER_ID" cannot create document with id "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (get) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can get their own profile document.
     * @deny (get) User with uid "OTHER_USER_ID" cannot get the profile document of "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (update) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can update their own profile document.
     * @deny (update) User with uid "OTHER_USER_ID" cannot update the profile document of "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (delete) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can delete their own profile document.
     * @deny (delete) User with uid "OTHER_USER_ID" cannot delete the profile document of "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to a user's clients subcollection only to the owner.
     * @path /users/{userId}/clients/{clientId}
     * @allow (create) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can create a client document under their user ID.
     * @deny (create) User with uid "OTHER_USER_ID" cannot create a client document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (get) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can get a client document under their user ID.
     * @deny (get) User with uid "OTHER_USER_ID" cannot get a client document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (list) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can list client documents under their user ID.
     * @deny (list) User with uid "OTHER_USER_ID" cannot list client documents under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (update) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can update a client document under their user ID.
     * @deny (update) User with uid "OTHER_USER_ID" cannot update a client document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (delete) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can delete a client document under their user ID.
     * @deny (delete) User with uid "OTHER_USER_ID" cannot delete a client document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/clients/{clientId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to a user's projects subcollection only to the owner.
     * @path /users/{userId}/projects/{projectId}
     * @allow (create) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can create a project document under their user ID.
     * @deny (create) User with uid "OTHER_USER_ID" cannot create a project document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (get) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can get a project document under their user ID.
     * @deny (get) User with uid "OTHER_USER_ID" cannot get a project document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (list) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can list project documents under their user ID.
     * @deny (list) User with uid "OTHER_USER_ID" cannot list project documents under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (update) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can update a project document under their user ID.
     * @deny (update) User with uid "OTHER_USER_ID" cannot update a project document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (delete) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can delete a project document under their user ID.
     * @deny (delete) User with uid "OTHER_USER_ID" cannot delete a project document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/projects/{projectId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to a user's time entries subcollection only to the owner.
     * @path /users/{userId}/timeEntries/{timeEntryId}
     * @allow (create) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can create a time entry document under their user ID.
     * @deny (create) User with uid "OTHER_USER_ID" cannot create a time entry document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (get) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can get a time entry document under their user ID.
     * @deny (get) User with uid "OTHER_USER_ID" cannot get a time entry document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (list) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can list time entry documents under their user ID.
     * @deny (list) User with uid "OTHER_USER_ID" cannot list time entry documents under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (update) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can update a time entry document under their user ID.
     * @deny (update) User with uid "OTHER_USER_ID" cannot update a time entry document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (delete) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can delete a time entry document under their user ID.
     * @deny (delete) User with uid "OTHER_USER_ID" cannot delete a time entry document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/timeEntries/{timeEntryId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to a user's invoices subcollection only to the owner.
     * @path /users/{userId}/invoices/{invoiceId}
     * @allow (create) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can create a invoice document under their user ID.
     * @deny (create) User with uid "OTHER_USER_ID" cannot create a invoice document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (get) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can get a invoice document under their user ID.
     * @deny (get) User with uid "OTHER_USER_ID" cannot get a invoice document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (list) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can list invoice documents under their user ID.
     * @deny (list) User with uid "OTHER_USER_ID" cannot list invoice documents under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (update) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can update a invoice document under their user ID.
     * @deny (update) User with uid "OTHER_USER_ID" cannot update a invoice document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (delete) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can delete a invoice document under their user ID.
     * @deny (delete) User with uid "OTHER_USER_ID" cannot delete a invoice document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/invoices/{invoiceId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to a user's expenses subcollection only to the owner.
     * @path /users/{userId}/expenses/{expenseId}
     * @allow (create) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can create a expense document under their user ID.
     * @deny (create) User with uid "OTHER_USER_ID" cannot create a expense document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (get) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can get a expense document under their user ID.
     * @deny (get) User with uid "OTHER_USER_ID" cannot get a expense document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (list) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can list expense documents under their user ID.
     * @deny (list) User with uid "OTHER_USER_ID" cannot list expense documents under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (update) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can update a expense document under their user ID.
     * @deny (update) User with uid "OTHER_USER_ID" cannot update a expense document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (delete) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can delete a expense document under their user ID.
     * @deny (delete) User with uid "OTHER_USER_ID" cannot delete a expense document under user ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/expenses/{expenseId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to a user's token document only to the owner.
     * @path /user_tokens/{userId}
     * @allow (create) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can create a user token document with their ID.
     * @deny (create) User with uid "OTHER_USER_ID" cannot create a user token document with ID "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (get) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can get their own user token document.
     * @deny (get) User with uid "OTHER_USER_ID" cannot get the user token document of "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (list) Listing is not allowed.
     * @deny (update) User with uid "OTHER_USER_ID" cannot update the user token document of "R7Hkky6alfgBwiofMmCVHo8HtLI3".
     * @allow (update) User with uid "R7Hkky6alfgBwiofMmCVHo8HtLI3" can update their own user token document.
     * @deny (delete) Deletion is not allowed.
     * @principle Restricts access to a user's own data tree.
     */
    match /user_tokens/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if false;
    }

        /**
     * @description Grants access to a referral document.
     * @path /referrals/{referralId}
     * @allow (create) Any signed-in user can create a referral document.
     * @deny (create) A non-signed in user cannot create referral document.
     * @allow (get) Any signed-in user can read a referral document.
     * @deny (get) A non-signed in user cannot read referral document.
     * @allow (list) Listing is not allowed.
     * @deny (update) No one can update referral document.
     * @deny (delete) No one can delete referral document.
     */
    match /referrals/{referralId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}